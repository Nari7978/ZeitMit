{
  "expo": {
    "name": "ZeitMit",
    "slug": "zeitmit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nari7978.zeitmit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE94D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nari7978.zeitmit",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "ZeitMit uses your photos so you can add a profile picture.",
          "cameraPermission": "ZeitMit uses the camera for your profile photo and the companion ID check."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "During a safety check-in, ZeitMit shares your location with your trusted contact only if you turn it on."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF4F8B"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "zeitmit",
    "backgroundColor": "#FFE94D",
    "owner": "akulav97",
    "extra": {
      "eas": {
        "projectId": "d533e166-c6d9-4927-bf05-0cf884d22f35"
      }
    }
  }
}
