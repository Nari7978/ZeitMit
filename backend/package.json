{
  "name": "zeitmit-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply zeitmit --local",
    "db:migrate:remote": "wrangler d1 migrations apply zeitmit --remote",
    "seed:gen": "node scripts/gen-seed.mjs",
    "seed:demo:local": "wrangler d1 execute DB --local --file scripts/demo-seed.sql",
    "test:engine": "esbuild scripts/engine-check.ts --bundle --platform=node --format=esm --outfile=.wrangler/engine-check.mjs --log-level=warning && node .wrangler/engine-check.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.153.0"
  }
}
