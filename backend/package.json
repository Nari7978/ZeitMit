{
  "name": "zeitmit-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply zeitmit --local",
    "db:migrate:remote": "wrangler d1 migrations apply zeitmit --remote",
    "seed:gen": "node scripts/gen-seed.mjs",
    "seed:demo:local": "wrangler d1 execute DB --local --file migrations/0002_seed_demo.sql"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.153.0"
  }
}
